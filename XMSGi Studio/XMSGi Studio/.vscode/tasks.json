{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Launch XMSGi Studio",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"start"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Run current application",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"run"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Test Studio UI",
			"type": "shell",
			"command": "npm",
			"args": [
				"test",
				"--",
				"src/studio/App.test.tsx",
				"src/studio/components/WorkspaceTextStage.test.tsx"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Build XMSGi Studio",
			"type": "shell",
			"command": "npm",
			"args": [
				"build"
			],
			"isBackground": false,
			"problemMatcher": [
				"$tsc"
			]
		},
		{
			"label": "Test HistoryDrawer",
			"type": "shell",
			"command": "npx",
			"args": [
				"vitest",
				"run",
				"src/workspace/HistoryDrawer.test.tsx",
				"--reporter=basic"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "test"
		},
		{
			"label": "Test HistoryDrawer 2",
			"type": "shell",
			"command": "npx",
			"args": [
				"vitest",
				"run",
				"src/workspace/HistoryDrawer.test.tsx",
				"--reporter=basic"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "test"
		}
	]
}