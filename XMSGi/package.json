{
  "name": "xmsgi-studio",
  "private": true,
  "version": "1.1.0",
  "license": "MIT",
  "repository": "https://github.com/molodoy01/XMSGi",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "electron": "electron . --no-sandbox",
    "start": "npm run build && npm run electron",
    "dist": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "teleproto": "^1.229.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "jsdom": "^30.1.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "vitest": "^2.1.9"
  },
  "main": "main.cjs",
  "build": {
    "appId": "com.xmsgi.app",
    "productName": "XMSGi Studio",
    "icon": "build/icon.ico",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "build/icon.ico",
      "main.cjs",
      "preload.cjs",
      "chat-storage.cjs",
      "app-data-path.cjs",
      "draft-store.cjs",
      "gemini.cjs",
      "telegram.cjs",
      "telegram-dialogs.cjs",
      "telegram-inline-keyboard.cjs",
      "telegram-errors.cjs",
      "telegram-account-storage.cjs",
      "telegram-lifecycle.cjs",
      "telegram-search.cjs",
      "telegram-dialog-search.cjs",
      "telegram-permissions.cjs",
      "telegram-idempotency.cjs",
      "schedule-history.cjs",
      "ipc-security.cjs",
      "package.json",
      "node_modules/**/*"
    ],
    "extraFiles": [],
    "extraResources": [],
    "win": {
      "target": [
        "portable"
      ]
    },
    "asar": true
  }
}